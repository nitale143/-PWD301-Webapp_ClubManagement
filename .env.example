AI_CHAT_MESSAGES_PER_MINUTE=20
AI_STRICT_FACTS=true
AI_AGENT_ENABLED=true
AI_AGENT_MAX_STEPS=3
AI_AGENT_MAX_SECONDS=90
SCHEDULER_ENABLED=true
