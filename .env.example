SECRET_KEY=replace-with-a-long-random-secret
APP_TIMEZONE=Asia/Bangkok
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_MAX_CALLS_PER_MINUTE=12
